set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Styling & Palette
ESC="\033["
RESET="${ESC}0m"
BOLD="${ESC}1m"
DIM="${ESC}2m"
EMERALD="${ESC}38;5;48m"
GREEN="${ESC}38;5;42m"
CYAN="${ESC}38;5;51m"
BLUE="${ESC}38;5;39m"
PURPLE="${ESC}38;5;141m"
YELLOW="${ESC}38;5;220m"
RED="${ESC}38;5;196m"
GRAY="${ESC}38;5;243m"
WHITE="${ESC}38;5;255m"

print_header() {
    echo -e "${EMERALD}"
    cat << "EOF"
  ██████╗ ███████╗██╗   ██╗██╗  ██╗ █████╗ ███╗   ██╗
  ██╔══██╗██╔════╝╚██╗ ██╔╝██║  ██║██╔══██╗████╗  ██║
  ██████╔╝█████╗   ╚████╔╝ ███████║███████║██╔██╗ ██║
  ██╔══██╗██╔══╝    ╚██╔╝  ██╔══██║██╔══██║██║╚██╗██║
  ██║  ██║███████╗   ██║   ██║  ██║██║  ██║██║ ╚████║
  ╚═╝  ╚═╝╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝
EOF
    echo -e "${RESET}"
    echo -e "   ${BOLD}${EMERALD}Reyhan CLI Orchestrator${RESET} ${DIM}│${RESET} ${WHITE}v1.0.0${RESET}"
    echo -e "   ${GRAY}Next-Gen Headless E-Commerce Framework (PHP 8.4+ / Laravel 13 / Filament v5)${RESET}\n"
}

show_help() {
    print_header
    echo -e "  ${BOLD}${WHITE}USAGE:${RESET}  ./reyhan <command> [options]\n"
    echo -e "  ${BOLD}AVAILABLE COMMANDS:${RESET}"
    echo -e "    ${EMERALD}version${RESET}             Display version matrix, drivers, and runtime status"
    echo -e "    ${EMERALD}doctor${RESET}              Run health, environment, and dependency diagnostics"
    echo -e "    ${EMERALD}install [--prod]${RESET}    Provision database, env, storage link, and admin panel"
    echo -e "    ${EMERALD}update${RESET}              Execute safe, zero-downtime core update & migrations"
    echo -e "    ${EMERALD}dev${RESET}                 Start backend development server"
    echo -e "    ${EMERALD}help${RESET}                Show this manual\n"
}

cmd_version() {
    print_header
    if [ -f "artisan" ]; then
        php artisan reyhan:version
    else
        echo -e "  ${RED}✖ artisan not detected in root directory.${RESET}"
    fi
}

cmd_doctor() {
    print_header
    if [ -f "artisan" ]; then
        php artisan reyhan:doctor
    else
        echo -e "  ${RED}✖ artisan not detected in root directory.${RESET}"
    fi
}

cmd_install() {
    print_header
    local MODE="dev"
    if [ "$1" == "--prod" ]; then
        MODE="prod"
    fi

    if [ "$MODE" == "prod" ]; then
        echo -e "  ${EMERALD}➜ Running production VPS automated installer (install.sh)...${RESET}\n"
        sudo bash install.sh
        return
    fi

    echo -e "  ${EMERALD}➜ Initializing Reyhan Local Development Environment...${RESET}\n"

    # Environment setup
    if [ ! -f ".env" ]; then
        if [ -f ".env.example" ]; then
            cp .env.example .env
            echo -e "  ${GREEN}✔${RESET} Created .env from template."
        fi
    fi

    echo -e "  ${EMERALD}●${RESET} Configuring application and running migrations..."
    php artisan reyhan:install --force

    echo -e "\n  ${GREEN}✨ Reyhan headless application setup completed!${RESET}"
    echo -e "  ${GRAY}Run: ${WHITE}./reyhan dev${GRAY} to start the development server.${RESET}\n"
}

cmd_update() {
    print_header
    echo -e "  ${EMERALD}➜ Initiating Reyhan Framework Zero-Downtime Update...${RESET}\n"

    if [ -f "artisan" ]; then
        php artisan reyhan:update "$@"
    fi

    echo -e "\n  ${GREEN}🎉 Reyhan core update completed successfully!${RESET}\n"
}

cmd_dev() {
    print_header
    echo -e "  ${EMERALD}➜ Starting Reyhan Headless Engine...${RESET}"
    echo -e "  ${GRAY}API Endpoints:     ${WHITE}http://localhost:8000/api/v1${RESET}"
    echo -e "  ${GRAY}Interactive Docs:  ${WHITE}http://localhost:8000/docs/api${RESET}"
    echo -e "  ${GRAY}Admin Backoffice:  ${WHITE}http://localhost:8000/admin${RESET}\n"

    php artisan serve --port=8000
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    version)
        cmd_version "$@"
        ;;
    doctor)
        cmd_doctor "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    update)
        cmd_update "$@"
        ;;
    dev)
        cmd_dev "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: ${COMMAND}${RESET}\n"
        show_help
        exit 1
        ;;
esac
