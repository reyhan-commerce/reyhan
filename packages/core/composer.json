{
    "name": "reyhan-commerce/core",
    "version": "1.0.0",
    "description": "Next-Gen Headless E-Commerce Core Framework for Laravel 13",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Reyhan Commerce Core Team",
            "email": "dev@reyhan.ir"
        }
    ],
    "require": {
        "php": "^8.4",
        "alareqi/filament-tree": "^1.0",
        "bezhansalleh/filament-shield": "^4.3",
        "bokshorn-it/filament-activity-timeline": "^1.4",
        "dedoc/scramble": "^0.13.45",
        "filament/filament": "^5.8",
        "filament/spatie-laravel-media-library-plugin": "^5.8",
        "filament/spatie-laravel-settings-plugin": "^5.8",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.49",
        "laravel/octane": "^2.19",
        "laravel/pennant": "^1.26",
        "laravel/pulse": "^1.8",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "marcusvbda/filament-realtime-driver": "^0.1.2",
        "morilog/jalali": "^3.4",
        "rankbeam/laravel-seo-filament": "^1.12",
        "shuvroroy/filament-spatie-laravel-backup": "^4.0",
        "shuvroroy/filament-spatie-laravel-health": "^3.3",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-sluggable": "^4.0",
        "zvizvi/filament-column-filters": "^0.0.6",
        "zvizvi/filament-notifications-tabs": "^0.0.3"
    },
    "autoload": {
        "psr-4": {
            "Reyhan\\Core\\": "src/",
            "App\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reyhan\\Core\\ReyhanServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
