includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    # Level 8 strictness
    level: 8

    ignoreErrors:
        - '#Call to an undefined method Filament\\Tables\\Table::(tree|socket)\(\)#'
        - '#Call to an undefined method Filament\\Tables\\Columns\\TextColumn::columnFilter\(\)#'
